<mxfile host="app.diagrams.net">
  <diagram name="CI-CD Pipeline" id="cicd">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="dev" value="Developer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#546E7A;fontColor=#263238;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="255" width="110" height="56" as="geometry" /></mxCell>

        <mxCell id="gitrepo" value="Git repo (app)" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;aspect=fixed;fontSize=12;fontColor=#263238;image=https://cdn.jsdelivr.net/npm/simple-icons@11/icons/github.svg;" vertex="1" parent="1"><mxGeometry x="215" y="255" width="52" height="52" as="geometry" /></mxCell>
        <mxCell id="gitnote" value="app + Helm + infra" style="text;html=1;align=center;fontSize=10;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="185" y="320" width="112" height="16" as="geometry" /></mxCell>

        <mxCell id="ci" value="GitHub Actions (CI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontColor=#1B5E20;fontSize=14;verticalAlign=top;align=center;spacingTop=8;container=1;collapsible=0;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="370" y="100" width="370" height="340" as="geometry" /></mxCell>
        <mxCell id="ciicon" value="" style="shape=image;html=1;aspect=fixed;image=https://cdn.jsdelivr.net/npm/simple-icons@11/icons/githubactions.svg;" vertex="1" parent="1"><mxGeometry x="380" y="108" width="24" height="24" as="geometry" /></mxCell>
        <mxCell id="s1" value="1 · lint + unit tests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66BB6A;fontColor=#1B5E20;fontSize=12;" vertex="1" parent="1"><mxGeometry x="395" y="150" width="320" height="36" as="geometry" /></mxCell>
        <mxCell id="s2" value="2 · build image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66BB6A;fontColor=#1B5E20;fontSize=12;" vertex="1" parent="1"><mxGeometry x="395" y="196" width="320" height="36" as="geometry" /></mxCell>
        <mxCell id="s3" value="3 · Trivy scan image (fail on HIGH)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66BB6A;fontColor=#1B5E20;fontSize=12;" vertex="1" parent="1"><mxGeometry x="395" y="242" width="320" height="36" as="geometry" /></mxCell>
        <mxCell id="s4" value="4 · tfsec / checkov (infra scan)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66BB6A;fontColor=#1B5E20;fontSize=12;" vertex="1" parent="1"><mxGeometry x="395" y="288" width="320" height="36" as="geometry" /></mxCell>
        <mxCell id="s5" value="5 · push image to ECR (tag = git sha)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66BB6A;fontColor=#1B5E20;fontSize=12;" vertex="1" parent="1"><mxGeometry x="395" y="334" width="320" height="36" as="geometry" /></mxCell>
        <mxCell id="s6" value="6 · commit new image tag to manifests repo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66BB6A;fontColor=#1B5E20;fontSize=12;" vertex="1" parent="1"><mxGeometry x="395" y="380" width="320" height="36" as="geometry" /></mxCell>

        <mxCell id="ecr" value="ECR" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elastic_container_registry;" vertex="1" parent="1"><mxGeometry x="835" y="150" width="50" height="50" as="geometry" /></mxCell>
        <mxCell id="ecrnote" value="image : git-sha" style="text;html=1;align=center;fontSize=10;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="805" y="212" width="110" height="16" as="geometry" /></mxCell>

        <mxCell id="mrepo" value="Manifests repo" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;aspect=fixed;fontSize=12;fontColor=#263238;image=https://cdn.jsdelivr.net/npm/simple-icons@11/icons/github.svg;" vertex="1" parent="1"><mxGeometry x="834" y="320" width="52" height="52" as="geometry" /></mxCell>
        <mxCell id="mreponote" value="GitOps · Helm values" style="text;html=1;align=center;fontSize=10;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="795" y="384" width="130" height="16" as="geometry" /></mxCell>

        <mxCell id="argo" value="Argo CD" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;aspect=fixed;fontSize=12;fontColor=#263238;image=https://cdn.jsdelivr.net/npm/simple-icons@11/icons/argo.svg;" vertex="1" parent="1"><mxGeometry x="1084" y="320" width="52" height="52" as="geometry" /></mxCell>

        <mxCell id="eks" value="EKS cluster" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elastic_kubernetes_service;" vertex="1" parent="1"><mxGeometry x="1085" y="490" width="50" height="50" as="geometry" /></mxCell>
        <mxCell id="eksnote" value="migrate Job (Helm hook) → web / rq / scheduler" style="text;html=1;align=center;whiteSpace=wrap;fontSize=10;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="1010" y="552" width="200" height="30" as="geometry" /></mxCell>

        <mxCell id="e1" value="git push" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;strokeColor=#333333;" edge="1" parent="1" source="dev" target="gitrepo"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="trigger on push" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;strokeColor=#333333;" edge="1" parent="1" source="gitrepo" target="ci"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="push image" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;strokeColor=#EF6C00;" edge="1" parent="1" source="s5" target="ecr"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="commit new tag" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;strokeColor=#546E7A;" edge="1" parent="1" source="s6" target="mrepo"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="watches (GitOps)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;strokeColor=#1565C0;" edge="1" parent="1" source="mrepo" target="argo"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="sync via Helm" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;strokeColor=#1565C0;" edge="1" parent="1" source="argo" target="eks"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="pull image" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;fontSize=11;strokeColor=#EF6C00;" edge="1" parent="1" source="ecr" target="eks"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="note" value="Two repos = GitOps: CI never touches the cluster. It writes to Git; Argo CD pulls. Every change is a commit — full audit, rollback = git revert." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;fillColor=#F9F9F9;strokeColor=#CCCCCC;rounded=1;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="300" height="80" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
